# Ghost Blog Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DB_PASSWORD=your_secure_ghost_db_password_here
DB_ROOT_PASSWORD=your_secure_mysql_root_password_here

# ============================================================================
# Mail Configuration (required for newsletters, password resets, magic links)
# ============================================================================
# Choose ONE provider below and comment out the others

# --- Option 1: Resend (RECOMMENDED - 3,000 emails/day free, great for devs) ---
# Sign up: resend.com | Get API key from Dashboard > API Keys
# IMPORTANT: Must verify your domain in Resend before sending
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASS=re_your_resend_api_key_here
MAIL_FROM=noreply@blog.gagangulyani.com

# --- Option 2: SendGrid (100 emails/day free) ---
# Sign up: sendgrid.com | Get API key from Settings > API Keys
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USER=apikey
# MAIL_PASS=SG.your_sendgrid_api_key_here
# MAIL_FROM=noreply@blog.gagangulyani.com

# --- Option 3: AWS SES (62,000 emails/month free from EC2) ---
# Requires AWS account and SES setup in your region
# MAIL_HOST=email-smtp.us-east-1.amazonaws.com
# MAIL_PORT=587
# MAIL_USER=your_ses_smtp_username
# MAIL_PASS=your_ses_smtp_password
# MAIL_FROM=noreply@blog.gagangulyani.com

# --- Option 4: Postmark (100 emails/month free, great deliverability) ---
# Sign up: postmarkapp.com | Get token from Servers > API Tokens
# MAIL_HOST=smtp.postmarkapp.com
# MAIL_PORT=587
# MAIL_USER=your_postmark_server_token
# MAIL_PASS=your_postmark_server_token
# MAIL_FROM=noreply@blog.gagangulyani.com

# --- Option 5: SMTP2GO (1,000 emails/month free) ---
# Sign up: smtp2go.com | Get credentials from Settings > SMTP Users
# MAIL_HOST=mail.smtp2go.com
# MAIL_PORT=587
# MAIL_USER=your_smtp2go_username
# MAIL_PASS=your_smtp2go_password
# MAIL_FROM=noreply@blog.gagangulyani.com

# --- Option 6: Mailjet (6,000 emails/month free) ---
# Sign up: mailjet.com | Get credentials from Account Settings
# MAIL_HOST=in-v3.mailjet.com
# MAIL_PORT=587
# MAIL_USER=your_mailjet_api_key
# MAIL_PASS=your_mailjet_secret_key
# MAIL_FROM=noreply@blog.gagangulyani.com

# --- Option 7: Elastic Email (100 emails/day free) ---
# Sign up: elasticemail.com | Create SMTP credentials
# MAIL_HOST=smtp.elasticemail.com
# MAIL_PORT=2525
# MAIL_USER=your_elastic_email_username
# MAIL_PASS=your_elastic_email_password
# MAIL_FROM=noreply@blog.gagangulyani.com

# --- Option 8: Gmail (NOT recommended for production, 100 emails/day limit) ---
# Use only for testing! Requires App Password (not regular password)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your_email@gmail.com
# MAIL_PASS=your_16_char_app_password
# MAIL_FROM=your_email@gmail.com

# ============================================================================

# Optional: Ghost Admin Initial Setup
# GHOST_ADMIN_EMAIL=your@email.com
# GHOST_ADMIN_PASSWORD=your_admin_password
