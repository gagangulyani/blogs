# Ghost Blog Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DB_PASSWORD=your_secure_ghost_db_password_here
DB_ROOT_PASSWORD=your_secure_mysql_root_password_here

# Mail Configuration (required for newsletters, password resets)
MAIL_SERVICE=Mailgun
MAIL_USER=postmaster@yourdomain.com
MAIL_PASS=your_mailgun_api_key
MAIL_FROM=noreply@blog.gagangulyani.com  # Or use your verified domain in Mailgun

# Optional: Ghost Admin Initial Setup
# GHOST_ADMIN_EMAIL=your@email.com
# GHOST_ADMIN_PASSWORD=your_admin_password
